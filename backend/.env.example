# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database URL Configuration (PostgreSQL / pgAdmin or SQLite)
# PostgreSQL Example: DATABASE_URL=postgresql://postgres:your_password@localhost:5432/travel_copilot_db
DATABASE_URL=

# Live Travel Data APIs (Live Flight, Train & Weather tracking)
SERPAPI_API_KEY=your_serpapi_google_flights_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
OPENWEATHER_API_KEY=your_openweather_key_here
